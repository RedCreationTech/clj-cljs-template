{:system/env
 #profile {:dev  :dev
           :test :test
           :prod :prod}

 ;; test profile 用不同端口,测试时开着 bb dev 也不会冲突
 :nrepl/server
 {:port #long #or [#env NREPL_PORT #profile {:dev 7000 :test 7100 :prod 7000}]
  :bind #or [#env NREPL_HOST "127.0.0.1"]}

 :server/http
 {:port    #long #or [#env PORT #profile {:dev 3000 :test 3100 :prod 3000}]
  :host    #or [#env HTTP_HOST "0.0.0.0"]
  :handler #ig/ref :handler/ring}

 :handler/ring
 {:router                #ig/ref :router/core
  :api-path              "/api"
  :query-fn              #ig/ref :db.sql/query-fn
  ;; 默认值仅供开发/测试;prod profile 下由 com.ruoyi.infra.secrets/verify! 强制要求 COOKIE_SECRET(16 字节)
  :cookie-secret         #or [#env COOKIE_SECRET "KWGRWFTDVZAHISQO"]
  ;; 允许跨域访问的前端地址,逗号分隔;默认空 = 只允许同源(前后端同端口部署时不需要 CORS)
  :cors-origins          #or [#env CORS_ORIGINS ""]
  :site-defaults-config  {:params    {:urlencoded true
                                      :multipart  true
                                      :nested     true
                                      :keywordize true}
                          :cookies   true
                          :session   {:flash true
                                      :cookie-name "com.ruoyi"
                                      :cookie-attrs {:max-age     86400
                                                     :http-only   true
                                                     :same-site   :strict}}
                          :security  {:anti-forgery   false
                                      :xss-protection {:enable? true, :mode :block}
                                      :frame-options  :sameorigin
                                      :content-type-options :nosniff}
                          :static    {:resources "public"}
                          :responses {:not-modified-responses true
                                      :absolute-redirects     true
                                      :content-types          true
                                      :default-charset        "utf-8"}}}

 :app.system/user-service
 {:query-fn #ig/ref :db.sql/query-fn
  :db       #ig/ref :db.sql/connection}

 :app.system/role-service
 {:query-fn #ig/ref :db.sql/query-fn
  :db       #ig/ref :db.sql/connection}

 :app.system/menu-service
 {:query-fn #ig/ref :db.sql/query-fn
  :db       #ig/ref :db.sql/connection}

 :app.system/dept-service
 {:query-fn #ig/ref :db.sql/query-fn
  :db       #ig/ref :db.sql/connection}

 :app.system/post-service
 {:query-fn #ig/ref :db.sql/query-fn
  :db       #ig/ref :db.sql/connection}

 :app.system/dict-service
 {:query-fn #ig/ref :db.sql/query-fn
  :db       #ig/ref :db.sql/connection}

 :app.system/config-service
 {:query-fn #ig/ref :db.sql/query-fn
  :db       #ig/ref :db.sql/connection}

 :app.system/form-template-service
 {:query-fn #ig/ref :db.sql/query-fn
  :db       #ig/ref :db.sql/connection}

 :app.system/log-service
 {:query-fn #ig/ref :db.sql/query-fn
  :db       #ig/ref :db.sql/connection}

 :app.system/online-service
 {:query-fn #ig/ref :db.sql/query-fn
  :db       #ig/ref :db.sql/connection}

 ;; 业务模块的 Integrant 组件登记在下面的标记之前(bb new-module 会自动插入;标记行请保留)
 ;; [new-module] components

 :app.system/job-scheduler
 {:scheduler  #ig/ref :cronut/scheduler
  :query-fn   #ig/ref :db.sql/query-fn
  :migrations #ig/ref :db.sql/migrations
  :db         #ig/ref :db.sql/connection
  ;; Quartz 用的是内存 JobStore:每个实例都会各自触发一遍 sys_job 里的任务。
  ;; 多实例部署时把从实例设为 SCHEDULER_ENABLED=false,只留一个实例跑任务。
  :enabled?   #boolean #or [#env SCHEDULER_ENABLED "true"]}

 :reitit.routes/api
 {:base-path      "/api"
  ;; 认证配置(见 com.ruoyi.web.controllers.auth/default-config);环境变量优先,其次按 profile
  :auth-config    {:token-ttl-minutes #long #or [#env TOKEN_TTL_MINUTES 720]
                   :captcha-enabled?  #boolean #or [#env CAPTCHA_ENABLED #profile {:dev "false" :test "false" :prod "true"}]
                   :register-enabled? #boolean #or [#env REGISTER_ENABLED "false"]
                   :max-failures      #long #or [#env LOGIN_MAX_FAILURES 5]
                   :lock-minutes      #long #or [#env LOGIN_LOCK_MINUTES 10]
                   ;; 登录页预填 admin/admin123,只在开发/测试环境
                   :demo-account?     #profile {:dev true :test true :prod false}}
  ;; 上传限制(见 com.ruoyi.infra.files):上传根目录、单文件大小上限(MB)与扩展名白名单(逗号分隔,留空用默认)
  ;; 目录相对 JVM 工作目录;容器里请挂到持久卷上,否则换容器就丢文件
  :upload-config  {:dir        #or [#env UPLOAD_DIR "uploads"]
                   :max-mb     #long #or [#env UPLOAD_MAX_MB 10]
                   :extensions #or [#env UPLOAD_EXTENSIONS ""]}
  :query-fn       #ig/ref :db.sql/query-fn
  :datasource     #ig/ref :db.sql/connection
  :user-service   #ig/ref :app.system/user-service
  :role-service   #ig/ref :app.system/role-service
  :menu-service   #ig/ref :app.system/menu-service
  :dept-service   #ig/ref :app.system/dept-service
  :post-service   #ig/ref :app.system/post-service
  :dict-service   #ig/ref :app.system/dict-service
  :config-service       #ig/ref :app.system/config-service
  :form-template-service #ig/ref :app.system/form-template-service
  :log-service          #ig/ref :app.system/log-service
  :online-service       #ig/ref :app.system/online-service
  ;; 业务模块的 service 注入给路由(bb new-module 自动插入;标记行请保留)
  ;; [new-module] route-services
  }

 :router/routes
 {:routes #ig/refset :reitit/routes}

 :router/core
 {:routes #ig/ref :router/routes
  :env #ig/ref :system/env}

 :cronut/scheduler
 {:schedule []}

 :db.sql/connection
 ;; 连接池上限可用 DB_MAX_ACTIVE 覆盖;SQLite 下 com.ruoyi.config/with-dialect-pool 会强制回 1
 #profile {:dev  {:jdbc-url   #or [#env JDBC_URL "jdbc:sqlite:ruoyi.db"]
                  :init-size  1
                  :min-idle   1
                  :max-idle   1
                  :max-active #long #or [#env DB_MAX_ACTIVE 1]
                  :connection-test-query "SELECT 1"
                  :validation-timeout 3000}
           ;; 测试用独立的 test.db,不污染开发库(bb test 每次先删除它)
           :test {:jdbc-url   #or [#env JDBC_URL "jdbc:sqlite:test.db"]
                  :init-size  1
                  :min-idle   1
                  :max-idle   1
                  :max-active #long #or [#env DB_MAX_ACTIVE 1]
                  :connection-test-query "SELECT 1"
                  :validation-timeout 3000}
           :prod {:jdbc-url   #or [#env JDBC_URL "jdbc:sqlite:ruoyi.db"]
                  :init-size  1
                  :min-idle   1
                  :max-idle   1
                  :max-active #long #or [#env DB_MAX_ACTIVE 1]
                  :connection-test-query "SELECT 1"
                  :validation-timeout 3000}}

 :db.sql/query-fn
 {:conn      #ig/ref :db.sql/connection
  :options   {}
  :filenames ["sql/system.sql" "sql/log.sql" "sql/job.sql"
              ;; [new-module] sql-files
              ]
  :env       #ig/ref :system/env}

 :db.sql/migrations
 #profile {:dev  {:store            :database
                  :db               {:datasource #ig/ref :db.sql/connection}
                  :migrate-on-init? true
                  :migration-dir    #or [#env MIGRATION_DIR "migrations-sqlite"]}
           :test {:store            :database
                  :db               {:datasource #ig/ref :db.sql/connection}
                  :migrate-on-init? true
                  :migration-dir    #or [#env MIGRATION_DIR "migrations-sqlite"]}
           :prod {:store            :database
                  :db               {:datasource #ig/ref :db.sql/connection}
                  ;; 多实例部署时从实例可设 MIGRATE_ON_INIT=false,避免和主实例抢同一批迁移
                  :migrate-on-init? #boolean #or [#env MIGRATE_ON_INIT "true"]
                  :migration-dir    #or [#env MIGRATION_DIR "migrations-sqlite"]}}}
