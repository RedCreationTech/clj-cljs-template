{:source-paths ["src/cljs" "env/dev/cljs" "test/cljs"]

 :dependencies [[reagent "2.0.1"]
                [re-frame "1.4.7"]
                [cljs-ajax "0.8.4"]
                [bidi "2.1.6"]]

 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js"
   :asset-path "/js"
   :modules    {:app {:init-fn com.ruoyi.frontend.app/init}}
   :devtools   {:after-load com.ruoyi.frontend.app/reload
                :preloads [com.ruoyi.frontend.dev-snapshot]}
   :compiler-options {:output-feature-set :es8
                      :language-in :es-next
                      :language-out :es6}
   :js-options {:ignore-asset-requires true
                :resolve {"@rc-component/qrcode" false
                          "@ant-design/qrcode" false
                          "qrcode.react" false}}}

  ;; 前端单元测试(bb test:cljs):test/cljs 下 *-test 命名空间,在 Node 里跑
  :test
  {:target    :node-test
   :output-to "target/cljs-test/node-tests.js"
   :ns-regexp "-test$"}}}
