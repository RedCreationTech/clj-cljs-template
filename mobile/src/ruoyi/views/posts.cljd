(ns ruoyi.views.posts
  "岗位列表的正文:服务端分页,页码与总数都以后端返回的 {:rows :total} 为准,
   与网页端 components/pagination 的口径一致(这里不写前端假搜索)。
   Scaffold、AppBar 和提示条在 ruoyi.views.shell 里,页面只提供正文。"
  (:require ["dart:async" :as a]
            ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [hti.re-dash.core :as rd]
            [ruoyi.theme :as theme]))

(defn- status-text [status]
  (if (= "0" status) "正常" "停用"))

(defn- row [palette post]
  (let [{:keys [post_id post_name post_code status remark]} post]
    (m/Card
      .margin (m/EdgeInsets.only .left theme/gap-lg .right theme/gap-lg .top theme/gap)
      .child (m/ListTile
               .title (m/Text (str post_name)
                              .style (m/TextStyle .fontSize 15.0
                                                  .color (:text-main palette)))
               .subtitle (m/Text (str "编号 " post_id " · " post_code " · "
                                      (status-text status)
                                      (if (some? remark) (str " · " remark) ""))
                              .style (m/TextStyle .color (:text-regular palette)))
               .trailing (m/Icon m/Icons.chevron_right .color (:border palette))))))

(defn- goto
  "翻到第 target 页的回调;不可翻时返回 nil(按钮变灰)。
   和 ruoyi.views.login/press 一样,必须经过函数返回,
   否则内联 (if … #(...) nil) 的 Function? 类型过不了 Dart 的 VoidCallback? 检查。"
  [enabled? target]
  (when enabled? #(rd/dispatch [:posts/change-page target])))

(defn- pager [palette {:keys [page total-pages total pending?]}]
  (let [moves? (not pending?)]
    (m/Row
      .mainAxisAlignment m/MainAxisAlignment.center
      .children
      [(m/IconButton
         .icon (m/Icon m/Icons.chevron_left .color (:text-main palette))
         .onPressed (goto (and moves? (> page 1)) (dec page)))
       (m/Text (str page " / " total-pages " 页 · 共 " total " 条")
               .style (m/TextStyle .color (:text-regular palette)))
       (m/IconButton
         .icon (m/Icon m/Icons.chevron_right .color (:text-main palette))
         .onPressed (goto (and moves? (< page total-pages)) (inc page)))])))

(defn- body [palette rows paging]
  (if (empty? rows)
    (m/Center
      .child (m/Text (or (:msg paging) "暂无数据")
                     .style (m/TextStyle .color (:text-regular palette))))
    (m/ListView .children (mapv #(row palette %) rows))))

(def view
  (f/widget
    :watch [paging (rd/subscribe [:posts/paging])
            rows (rd/subscribe [:posts/rows])
            palette (rd/subscribe [:ui/palette])]
    (m/Column
      .children
      [(if (:pending? paging)
         (m/CircularProgressIndicator .color (:primary palette))
         (m/SizedBox .height 0.0))
       ;; RefreshIndicator 要求子树里可滚动,所以它包的是正文而不是整个 Column。
       (m/Expanded
         .child (m/RefreshIndicator
                  .onRefresh (fn [] (rd/dispatch [:posts/refresh]) (await (a/Future.value nil)))
                  .child (body palette rows paging)))
       (pager palette (update paging :total-pages (fn [n] (max 1 (or n 1)))))])))
