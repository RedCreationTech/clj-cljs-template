(ns ruoyi.views.shell
  "外壳:一份 Scaffold,按 app-db 里的 :route 换正文,提示条挂在底部。
   登录态是数据(:route),不是 Flutter 的导航栈,所以「会话失效」时
   只需要一条事件把状态清回登录页,不会出现返回栈里残留已登录页面。

   配色一律来自订阅 [:ui/palette](键名 → 色值),视图里不出现 #RRGGBB;
   主题开关放在 AppBar 上,登录页也有,方便不换身份就能试深色。"
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [hti.re-dash.core :as rd]
            [ruoyi.theme :as theme]
            [ruoyi.views.login :as login]
            [ruoyi.views.posts :as posts]))

(defn- theme-icon
  "开关按钮的图标:必须经函数返回 dynamic,内联 (if …) 的 IconData? 过不了类型检查。"
  [dark?]
  (if dark? m/Icons.light_mode m/Icons.dark_mode))

(defn- toggle-button [dark?]
  (m/IconButton
    .icon (m/Icon (theme-icon dark?) .color m/Colors.white)
    .tooltip (if dark? "切换为浅色主题" "切换为深色主题")
    .onPressed #(rd/dispatch [:ui/toggle-theme])))

(defn- logout-button []
  (m/IconButton
    .icon (m/Icon m/Icons.exit_to_app .color m/Colors.white)
    .tooltip "退出登录"
    .onPressed #(rd/dispatch [:auth/logout])))

(defn- app-bar [route profile dark?]
  ;; 注意是 [(toggle-button dark?)] 而不是 [toggle-button dark?]:后者是把函数本身
  ;; 和参数塞进向量,AppBar 拿到的是两个非 Widget,Dart 侧只在渲染时才炸。
  (m/AppBar
    .title (m/Text (if (= :login route) "登录" (str (:nick_name profile "工作台"))))
    .actions (if (= :login route)
               [(toggle-button dark?)]
               [(toggle-button dark?) (logout-button)])))

(defn- notice-bar [palette {:keys [msg seq]}]
  (if (nil? msg)
    (m/SizedBox .height 0.0)
    ;; key 用 seq:同一条文案连续来两次也要重新显示,不然 Widget 被复用就看不出刷新过。
    (m/Container
      .key (m/ValueKey (str "notice-" seq))
      .color (:danger-bg palette)
      .padding (m/EdgeInsets.symmetric .vertical 10.0 .horizontal theme/gap-lg)
      .child (m/Text msg .style (m/TextStyle .color (:danger palette))))))

(def view
  (f/widget
    :watch [route (rd/subscribe [:app/route])
            profile (rd/subscribe [:ui/profile])
            notice (rd/subscribe [:ui/notice])
            dark? (rd/subscribe [:ui/dark?])
            palette (rd/subscribe [:ui/palette])]
    (m/Scaffold
      .appBar (app-bar route profile dark?)
      .body (if (= :login route) login/view posts/view)
      .bottomNavigationBar (notice-bar palette notice))))
