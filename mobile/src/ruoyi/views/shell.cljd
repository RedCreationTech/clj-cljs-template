(ns ruoyi.views.shell
  "通用应用外壳：品牌、账号详情、主题切换和全局反馈；认证路由仍由 app-db 驱动。"
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [hti.re-dash.core :as rd]
            [ruoyi.brand :as brand]
            [ruoyi.views.components :as ui]
            [ruoyi.views.login :as login]
            [ruoyi.views.posts :as posts]))

(defn- theme-icon [dark?] (if dark? m/Icons.light_mode_outlined m/Icons.dark_mode_outlined))

(defn- toggle-button [dark?]
  (m/IconButton .icon (m/Icon (theme-icon dark?))
                .tooltip (brand/label (if dark? :light-theme :dark-theme))
                .onPressed #(rd/dispatch [:ui/toggle-theme])))

(defn- logout-button []
  (m/IconButton .icon (m/Icon m/Icons.logout_outlined) .tooltip (brand/label :logout)
                .onPressed #(rd/dispatch [:auth/logout])))

(defn- profile-value [value]
  (if (or (nil? value) (= "" value)) (brand/label :unspecified) (str value)))

(defn- close-button [context]
  (m/IconButton .tooltip (brand/label :close) .icon (m/Icon m/Icons.close)
                .onPressed #(.pop (m/Navigator.of context))))

(defn- account-logout [context]
  (m/FilledButton .child (m/Text (brand/label :logout))
                  .onPressed #(do (.pop (m/Navigator.of context)) (rd/dispatch [:auth/logout]))))

(defn- account-content [palette profile permissions dark? context]
  (ui/stack
   [(m/Row .children
           [(m/Expanded .child (ui/heading palette (brand/label :account) brand/tagline m/Icons.account_circle_outlined))
            (close-button context)])
    (ui/gap 20.0)
    (ui/card palette
             [(ui/text palette (profile-value (:nick_name profile)) 23.0 true)
              (ui/muted palette (str (brand/label :username) " · " (profile-value (:user_name profile))))
              (ui/gap 12.0)
              (when-let [department (or (:dept_name profile) (get-in profile [:dept :dept_name]))]
                (ui/detail palette (brand/label :department) (profile-value department)))
              (ui/detail palette (brand/label :email) (profile-value (:email profile)))
              (ui/detail palette (brand/label :phone) (profile-value (:phonenumber profile)))])
    (ui/card palette
             [(ui/text palette (brand/label :permissions) 17.0 true)
              (ui/muted palette (if (contains? permissions "*:*:*") (brand/label :all-permissions)
                                    (str (count permissions) " " (brand/label :permissions-suffix))))
              (ui/gap 12.0) (ui/muted palette (brand/label :account-note))])
    (m/Wrap .spacing 8.0 .runSpacing 8.0
            .children [(toggle-button dark?) (account-logout context)])]))

(defn- account-view [context]
  (f/widget :watch [profile (rd/subscribe [:ui/profile])
                    permissions (rd/subscribe [:ui/permissions])
                    dark? (rd/subscribe [:ui/dark?])
                    signed-in? (rd/subscribe [:auth/signed-in?])
                    palette (rd/subscribe [:ui/palette])]
            (m/Container .color (:bg palette)
                         .child (m/SingleChildScrollView .padding (m/EdgeInsets.all 20.0)
                                                         .child (ui/centered
                                                                 (if signed-in? (account-content palette profile permissions dark? context)
                                                                     (ui/stack [(ui/text palette (brand/label :welcome) 23.0 true)
                                                                                (close-button context)]))
                                                                 640.0)))))

(defn- account-press
  "回调经函数返回 dynamic，避免 Future 返回值被推断成 VoidCallback 的 return。"
  [context]
  (fn []
    (m/showModalBottomSheet .context context .isScrollControlled true
      .showDragHandle true .useSafeArea true
      .builder (fn [sheet-context] (account-view sheet-context)))))

(defn- account-button []
  (f/widget :context context
    (m/IconButton .icon (m/Icon m/Icons.account_circle_outlined) .tooltip (brand/label :account)
      .onPressed (account-press context))))

(defn- app-bar [palette route dark?]
  (m/AppBar .centerTitle false .toolbarHeight 72.0
            .title (m/Row .children
            [(m/Icon m/Icons.dashboard_outlined .color (:accent palette) .size 23.0)
             (m/SizedBox .width 10.0)
             (m/Expanded .child (ui/text palette brand/name 16.0 true))])
            .actions (if (= :login route) [(toggle-button dark?)]
                         [(account-button) (toggle-button dark?) (logout-button)])))

(defn- notice-bar [palette {:keys [msg seq]}]
  (if (nil? msg) (m/SizedBox.shrink)
      (m/SafeArea .top false
                  .child (m/Container .key (m/ValueKey (str "notice-" seq))
                                      .padding (m/EdgeInsets.all 12.0) .color (:bg palette)
                                      .child (ui/message palette msg)))))

(def view
  (f/widget :watch [route (rd/subscribe [:app/route])
                    notice (rd/subscribe [:ui/notice])
                    dark? (rd/subscribe [:ui/dark?])
                    palette (rd/subscribe [:ui/palette])]
            (m/Scaffold .appBar (app-bar palette route dark?)
                        .body (if (= :login route) login/view posts/view)
                        .bottomNavigationBar (notice-bar palette notice))))
