(ns ruoyi.views.login
  "响应式品牌入口与登录表单。输入仍由 Flutter controller 管理，认证走共享事件。"
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [hti.re-dash.core :as rd]
            [ruoyi.brand :as brand]
            [ruoyi.views.components :as ui]))

(def username-ctrl (m/TextEditingController))
(def password-ctrl (m/TextEditingController))

(defn- text-of [^m/TextEditingController controller] (.-text controller))

(defn- submit []
  (let [u (text-of username-ctrl) p (text-of password-ctrl)]
    (if (or (= "" u) (= "" p))
      (rd/dispatch [:ui/notify (brand/label :required)])
      (rd/dispatch [:auth/login u p]))))

(defn- field [controller label obscure? icon pending?]
  (m/TextField .controller controller .obscureText obscure? .enabled (not pending?)
    .textInputAction m/TextInputAction.done
    .autocorrect false .enableSuggestions (not obscure?)
    .decoration (m/InputDecoration .labelText label .prefixIcon (m/Icon icon))
    .onSubmitted (fn [_] (when-not pending? (submit)))))

(defn- brand-card [palette]
  (m/Container .padding (m/EdgeInsets.all 26.0)
    .decoration (m/BoxDecoration .color (:brand palette)
                  .borderRadius (m/BorderRadius.circular 24.0))
    .child (ui/stack
             [(m/Row .crossAxisAlignment m/CrossAxisAlignment.start
                .children [(m/Icon m/Icons.dashboard_outlined .color (:accent palette) .size 28.0)
                           (m/SizedBox .width 12.0)
                           (m/Expanded .child (m/Text brand/name
                             .style (m/TextStyle .color (:on-brand palette)
                                       .fontSize 17.0 .height 1.5 .fontWeight m/FontWeight.w600)))])
              (ui/gap 24.0)
              (m/Text brand/headline .style (m/TextStyle .color (:on-brand palette)
                                             .fontSize 28.0 .height 1.4 .fontWeight m/FontWeight.w700))
              (ui/gap 12.0)
              (m/Text brand/description .style (m/TextStyle .color (:on-brand palette)
                                                .fontSize 14.0 .height 1.7))
              (ui/gap 20.0)
              (m/Wrap .spacing 8.0 .runSpacing 8.0
                .children (mapv #(ui/chip palette % :accent-text :accent-bg) brand/features))])))

(defn- press [pending?] (if pending? nil submit))

(defn- login-button [palette pending?]
  (m/FilledButton .onPressed (press pending?)
    .style (m/FilledButton.styleFrom .minimumSize (m/Size 0.0 50.0)
             .padding (m/EdgeInsets.symmetric .vertical 14.0 .horizontal 20.0)
             .shape (m/RoundedRectangleBorder .borderRadius (m/BorderRadius.circular 12.0)))
    .child (if pending?
             (m/Semantics .label (brand/label :login-pending) .liveRegion true
               .child (m/SizedBox .width 20.0 .height 20.0
                        .child (m/CircularProgressIndicator .color (:on-primary palette) .strokeWidth 2.0)))
             (m/Text (brand/label :login) .style (m/TextStyle .fontSize 15.0 .fontWeight m/FontWeight.w600)))))

(defn- form [palette {:keys [pending? msg]}]
  (ui/card palette
    [(ui/text palette (brand/label :welcome) 23.0 true)
     (ui/muted palette (brand/label :login-subtitle))
     (ui/gap 22.0)
     (field username-ctrl (brand/label :username) false m/Icons.person_outline pending?)
     (ui/gap 14.0)
     (field password-ctrl (brand/label :password) true m/Icons.lock_outline pending?)
     (ui/gap 14.0)
     (when (some? msg) (ui/message palette msg))
     (ui/gap 10.0)
     (login-button palette pending?)
     (ui/gap 16.0)
     (ui/muted palette (brand/label :login-note))]))

(defn- layout [palette login ^m/BoxConstraints constraints]
  (if (>= (.-maxWidth constraints) 800.0)
    (m/Row .crossAxisAlignment m/CrossAxisAlignment.start
      .children [(m/Expanded .child (brand-card palette)) (m/SizedBox .width 24.0)
                 (m/Expanded .child (form palette login))])
    (ui/stack [(brand-card palette) (ui/gap 20.0) (form palette login)])))

(def view
  (f/widget :watch [login (rd/subscribe [:login/state])
                    palette (rd/subscribe [:ui/palette])]
    (m/SafeArea .child (m/Center
      .child (m/SingleChildScrollView .padding (m/EdgeInsets.all 20.0)
        .child (ui/centered
                 (m/LayoutBuilder .builder (fn [_ constraints] (layout palette login constraints)))
                 960.0))))))
