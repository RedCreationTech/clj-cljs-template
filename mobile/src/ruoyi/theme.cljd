(ns ruoyi.theme
  "可定制品牌与明暗两套语义色板。视图不散落色值，操作与状态沿用若依色系。
   更换品牌时修改 brand / accent，新增操作仍用 primary 蓝色。"
  (:require ["package:flutter/material.dart" :as m]))

(defn- hex [r g b] (m/Color.fromARGB 255 r g b))

(def primary (hex 0x40 0x9e 0xff))
(def danger (hex 0xf5 0x6c 0x6c))
(def brand (hex 0x16 0x32 0x4f))
(def accent (hex 0xe9 0x85 0x3a))

(def light
  {:primary primary :on-primary (hex 0x0b 0x27 0x42)
   :brand brand :on-brand m/Colors.white
   :accent accent :accent-text (hex 0x9b 0x49 0x12) :accent-bg (hex 0xff 0xf2 0xe7)
   :danger danger :danger-text (hex 0xb8 0x32 0x32) :danger-bg (hex 0xfe 0xf0 0xf0)
   :success (hex 0x67 0xc2 0x3a) :success-text (hex 0x36 0x73 0x1b) :success-bg (hex 0xf0 0xf9 0xeb)
   :text-main (hex 0x18 0x2c 0x3a) :text-regular (hex 0x5b 0x6d 0x7d)
   :border (hex 0xde 0xe6 0xed) :bg (hex 0xf3 0xf6 0xf8)
   :surface m/Colors.white :surface-soft (hex 0xee 0xf3 0xf7)})

(def dark
  {:primary (hex 0x8e 0xc5 0xff) :on-primary (hex 0x0b 0x27 0x42)
   :brand brand :on-brand m/Colors.white
   :accent (hex 0xf5 0xa2 0x61) :accent-text (hex 0xf5 0xa2 0x61) :accent-bg (hex 0x3a 0x2b 0x20)
   :danger (hex 0xff 0x93 0x93) :danger-text (hex 0xff 0x93 0x93) :danger-bg (hex 0x3a 0x24 0x2a)
   :success (hex 0x85 0xca 0xad) :success-text (hex 0x85 0xca 0xad) :success-bg (hex 0x1b 0x35 0x2d)
   :text-main (hex 0xe6 0xee 0xf5) :text-regular (hex 0xa4 0xb5 0xc5)
   :border (hex 0x35 0x49 0x5d) :bg (hex 0x11 0x20 0x2d)
   :surface (hex 0x1a 0x2d 0x3e) :surface-soft (hex 0x24 0x38 0x4b)})

(defn palette-of [dark?] (if dark? dark light))
(def gap 8.0)
(def gap-lg 16.0)

(defn- theme-of [p brightness]
  (m/ThemeData
    .useMaterial3 true
    .colorScheme (.copyWith (m/ColorScheme.fromSeed .seedColor brand .brightness brightness)
                   .primary (:primary p) .onPrimary (:on-primary p)
                   .secondary (:accent p) .surface (:surface p) .onSurface (:text-main p)
                   .error (:danger-text p) .onSurfaceVariant (:text-regular p))
    .scaffoldBackgroundColor (:bg p)
    .dividerColor (:border p)
    .appBarTheme (m/AppBarTheme .backgroundColor (:surface p)
                    .foregroundColor (:text-main p) .elevation 0.0 .scrolledUnderElevation 0.0)
    .inputDecorationTheme (m/InputDecorationTheme
                            .filled true .fillColor (:surface-soft p)
                            .contentPadding (m/EdgeInsets.all 16.0)
                            .border (m/OutlineInputBorder
                                      .borderRadius (m/BorderRadius.circular 12.0)
                                      .borderSide m/BorderSide.none))))

(def data (theme-of light m/Brightness.light))
(def dark-data (theme-of dark m/Brightness.dark))
(defn theme-for [dark?] (if dark? dark-data data))
