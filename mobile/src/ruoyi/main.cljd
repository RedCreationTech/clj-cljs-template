(ns ruoyi.main
  "移动端入口。先 register! 再 run:re-dash 的处理器必须在第一帧之前登记完,
   否则视图订阅不到任何东西。"
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [hti.re-dash.core :as rd]
            [ruoyi.brand :as brand]
            [ruoyi.model :as model]
            [ruoyi.views.shell :as shell]))

(defn- root
  "整棵树的根:MaterialApp 的主题订自 app-db,所以 :ui/toggle-theme 一派发,
   连带 Card / AppBar 的默认配色会一起翻过来,不需要任何视图自己响应。"
  []
  (f/widget
    :watch [theme-data (rd/subscribe [:ui/theme])]
    (m/MaterialApp
      .title brand/name
      .debugShowCheckedModeBanner false
      .theme theme-data
      .home shell/view)))

(defn main []
  (model/register!)
  (f/run (root)))
